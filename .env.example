# Exemplo SEM credenciais reais. Este arquivo não ativa serviços externos.
# Copie para .env privado e use: node --env-file=.env server/study-server.mjs
# Nunca incluir segredos no frontend, GitHub, screenshots ou logs.

# unconfigured | n8n | openai. Manter desativado até autorização de custos/acesso.
AI_PROVIDER=unconfigured

# API e arquivos do build, mesma origem. HTTPS obrigatório fora de localhost.
PORT=8787
TRILHA_ALLOWED_ORIGIN=http://127.0.0.1:8787
TRILHA_STATIC_DIRECTORY=dist

# Token ALEATÓRIO de operador, mínimo 32 caracteres quando ativado.
# NÃO é a chave do provedor. Não distribuir em uma página pública.
TRILHA_ACCESS_TOKEN=
TRILHA_REQUESTS_PER_MINUTE=5
TRILHA_TIMEOUT_MS=25000

# Apenas modo openai. Escolher modelo e conferir custos antes de preencher.
AI_API_KEY=
AI_MODEL=

# Apenas modo n8n. Instância própria/autorizada; HTTPS e segredo distintos.
N8N_WEBHOOK_URL=https://example.invalid/webhook/trilha-viva-study
N8N_SHARED_SECRET=
